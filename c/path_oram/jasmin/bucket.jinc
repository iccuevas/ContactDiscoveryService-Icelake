require "tree_path.jinc"
require "pointers.jinc"

fn bucket_store_read_bucket_blocks(
  reg u64 bucket_store,
  reg u64 bucket_id,
  reg u64 bucket_data,
  #msf reg u64 msf
) -> #msf reg u64
{
  reg u512 s;
  reg u256 t;
  reg u128 r;
  reg u64 offset encrypted_bucket data;
  inline int i c;

  data, msf = bucket_store_data(bucket_store, msf);
  offset = bucket_id * ENCRYPTED_BUCKET_SIZE;
  encrypted_bucket = data + offset;
  c = (DECRYPTED_BLOCK_SIZE_QWORDS * BLOCKS_PER_BUCKET) / 8;
  for i = 0 to c
  {
    s = (u512)[encrypted_bucket + 64 * i];
    (u512)[bucket_data + 64 * i] = s;
  }
  t = (u256)[encrypted_bucket + 64 * c];
  (u256)[bucket_data + 64 * c] = t;
  r = (u128)[encrypted_bucket + 64 * c + 32];
  (u128)[bucket_data + 64 * c + 32] = r;
  return msf;
}

fn bucket_store_write_bucket_blocks(
  reg u64 bucket_store,
  reg u64 bucket_id,
  reg u64 bucket_data,
  #msf reg u64 msf
) -> #msf reg u64
{
  reg u512 s;
  reg u256 t;
  reg u128 r;
  reg u64 offset encrypted_bucket data;
  inline int i c;

  data, msf = bucket_store_data(bucket_store, msf);
  offset = bucket_id * ENCRYPTED_BUCKET_SIZE;
  encrypted_bucket = data + offset;
  c = (DECRYPTED_BLOCK_SIZE_QWORDS * BLOCKS_PER_BUCKET) / 8;
  for i = 0 to c
  {
    s = (u512)[bucket_data + 64 * i];
    (u512)[encrypted_bucket + 64 * i] = s;
  }
  t = (u256)[bucket_data + 64 * c];
  (u256)[encrypted_bucket + 64 * c] = t;
  r = (u128)[bucket_data + 64 * c + 32];
  (u128)[encrypted_bucket + 64 * c + 32] = r;

  return msf;
}